// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model Day {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique @db.Date  // just the date, no time component

  dailyGameId Int?  @unique
  dailyGame   Game? @relation(fields: [dailyGameId], references: [id])

  gridSlots     GridSlot[]
  dailyAttempts DailyAttempt[]
}

model Game {
  id          Int      @id @default(autoincrement())
  igdbId      Int      @unique
  name        String
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  releaseDate DateTime?
  totalRating Float?

  franchiseId Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  dailyFor  Day?

  genres GameOnGenre[]

  platforms GameOnPlatform[]

  screenshots Screenshot[]

  gridSlots GridSlot[]

  gridGuesses GridGuess[]

  dailyAttempts DailyAttempt[]
}


model Franchise {
  id     Int    @id @default(autoincrement())
  igdbId Int    @unique
  name   String

  games Game[]
}

model Genre {
  id  Int @id @default(autoincrement())
  igdbId  Int @unique
  name  String

  games GameOnGenre[]
}

model GameOnGenre {
  gameId  Int
  game  Game @relation(fields: [gameId], references: [id])

  genreId Int
  genre Genre  @relation(fields: [genreId], references: [id])

  @@id([gameId, genreId])
}

model Platform {
  id  Int @id @default(autoincrement())
  igdbId  Int @unique
  name  String

  games GameOnPlatform[]
}

model GameOnPlatform {
  gameId  Int
  game  Game @relation(fields: [gameId], references: [id])

  platformId  Int
  platform  Platform @relation(fields: [platformId], references: [id])

  @@id([gameId, platformId])
}

model Screenshot {
  id     Int @id @default(autoincrement())
  igdbId Int @unique
  url    String
  width  Int
  height Int

  gameId Int
  game   Game @relation(fields: [gameId], references: [id])
}


model GridSlot {
  id Int  @id @default(autoincrement())

  dayId Int
  day      Day  @relation(fields: [dayId], references: [id])

  position  Int
  gameId  Int @unique
  game  Game @relation(fields: [gameId], references: [id])

  gridGuesses GridGuess[]

  @@unique([dayId, position])
}

model User {
  id  String @id @default(cuid())
  username  String @unique
  email String  @unique
  passwordHash  String? //null for users who only sign in with Google

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gridGuesses GridGuess[]

  dailyAttempts DailyAttempt[]
}

model DailyAttempt {
  id  Int @id @default(autoincrement())

  userId  String
  user         User     @relation(fields: [userId], references: [id])

  dayId Int
  day Day @relation(fields: [dayId], references: [id])

  attemptNumber Int

  guessedGameId Int
  guessedGame   Game    @relation(fields: [guessedGameId], references: [id])

  correct      Boolean

  @@unique([userId, dayId, attemptNumber])
}

// --- Grid guesses (one row per slot the user has guessed) ---
model GridGuess {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  gridSlotId Int
  gridSlot   GridSlot @relation(fields: [gridSlotId], references: [id])
  guessedGameId Int
  guessedGame   Game  @relation(fields: [guessedGameId], references: [id])
  correct    Boolean
  createdAt  DateTime @default(now())

  @@unique([userId, gridSlotId]) // one guess per user per slot
}
